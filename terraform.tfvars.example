# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored — your credentials never get committed.

# --- Oracle Cloud API credentials ---
# For each line below, replace the ENTIRE text between the quotes
# with your real value — the placeholder text is just showing you
# the expected format, not something to append to.
#
# Where each value comes from (full walkthrough: README.md → "Get
# your API credentials"):

# Console → profile icon (top right) → "Tenancy: <your name>" → OCID
# shown on that page.
tenancy_ocid = "ocid1.tenancy.oc1...PASTE_YOUR_TENANCY_OCID"

# Console → profile icon → "My Profile" → OCID shown at the top.
user_ocid = "ocid1.user.oc1...PASTE_YOUR_USER_OCID"

# Console → My Profile → "API keys" tab → after you generate a key
# pair, the fingerprint is displayed immediately — looks like
# aa:bb:cc:...
fingerprint = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"

# Local path to the .pem file you downloaded when generating the API
# key above. Leave as-is if you saved it to ~/.oci/oci_api_key.pem as
# suggested; otherwise point this at wherever you actually saved it.
#
# Windows note: the OCI provider does NOT expand a leading ~ on
# Windows (this is a real, confirmed gap — Terraform's own file()
# calls handle ~ fine, but the OCI provider's own config loader
# doesn't). If you're on Windows, use a full path instead, e.g.:
#   private_key_path = "C:/Users/you/.oci/oci_api_key.pem"
# (forward slashes, even on Windows — backslashes need escaping in
# HCL strings and are easy to get wrong).
private_key_path = "~/.oci/oci_api_key.pem"

# For a new account this is usually identical to tenancy_ocid — the
# root compartment, shown in the console as "<your name> (root)".
# Paste the same value as tenancy_ocid above unless you've created a
# separate compartment.
compartment_ocid = "ocid1.compartment.oc1...PASTE_YOUR_COMPARTMENT_OCID"

# --- Region ---
# Must be your account's home region — Always Free resources can't be
# created outside it without upgrading to Pay As You Go. The console
# shows your home region under Profile → Tenancy.
region = "ap-hyderabad-1"

# --- Availability domain ---
# 0 = AD-1, 1 = AD-2, 2 = AD-3. If you hit "out of capacity" on one,
# try the next — see README.md → "Out of capacity".
availability_domain_index = 0

# --- Instance sizing ---
# Always Free historically allowed up to 4 OCPU / 24 GB; some newer
# accounts are capped at 2 OCPU / 12 GB. Check the console's live
# "Always Free-eligible" badge and adjust these to match — going over
# your account's real limit will fail the request, not overcharge you.
instance_ocpu      = 4
instance_memory_gb = 24

# --- Instance name ---
# instance_name is the display name shown in the console. hostname_label
# sets the VM's actual DNS hostname within the VCN — a separate field,
# worth setting to match if you want them consistent.
instance_name  = "free-tier-vm"
hostname_label = "free-tier-vm"

# --- App port ---
# Publicly opened alongside SSH. Set to whatever you plan to run
# (3000, 8080, etc.), or ignore if you'll only ever connect over SSH.
app_port = 3000

# --- SSH key ---
# This is how you'll log into the VM after creation.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
